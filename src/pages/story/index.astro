---
import { getCollection } from 'astro:content';
import Doc from '../../layouts/Doc.astro';

const stories = (await getCollection('story', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const dateFmt = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Doc title="Story" description="Notes from building software, products and companies." path="story">
  <h1>Story</h1>
  <p>Notes from building software, products and companies.</p>
  {stories.length === 0 && <p class="empty mono">first story is being written. check back soon.</p>}
  <ul class="list">
    {
      stories.map((s) => (
        <li>
          <time class="mono" datetime={s.data.date.toISOString()}>
            {dateFmt.format(s.data.date)}
          </time>
          <a href={`/story/${s.id}`}>{s.data.title}</a>
          <p>{s.data.description}</p>
        </li>
      ))
    }
  </ul>
</Doc>

<style>
  .empty {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--faint);
  }
  .list {
    list-style: none;
    padding: 0 !important;
    margin: 2.5rem 0 0;
  }
  .list li {
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    margin: 0;
  }
  time {
    display: block;
    font-size: 0.6875rem;
    color: var(--faint);
  }
  a {
    font-size: 1rem;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .list p {
    margin: 0.25rem 0 0;
  }
</style>
