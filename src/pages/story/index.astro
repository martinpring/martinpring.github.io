---
import { render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import StoryTabs from '../../components/StoryTabs.astro';
import { getEntries, byYear, SOURCE_LABEL } from '../../lib/timeline';

// Stories and short posts, newest first. Roles and milestones live on /story/timeline.
const entries = (await getEntries()).filter((e) => e.data.kind === 'story' || e.data.kind === 'post');
const rendered = new Map<string, Awaited<ReturnType<typeof render>>['Content']>();
for (const e of entries) {
  if (e.data.kind === 'post') rendered.set(e.id, (await render(e)).Content);
}
const years = byYear(entries);
const day = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short' });
const isDev = import.meta.env.DEV;
---

<Doc title="Story" description="Writing from the journey: building Tradesnap, Real Logic and what happens along the way." path="story">
  <h1>Story</h1>
  <p>Writing from the journey: building Tradesnap, Real Logic and what happens along the way. Newest first.</p>
  <StoryTabs current="stories" />

  {
    entries.length === 0 ? (
      <p class="empty mono">first story is being written. check back soon.</p>
    ) : (
      <div class="timeline">
        {years.map(([year, list]) => (
          <section class="year" aria-labelledby={`y-${year}`}>
            <h2 id={`y-${year}`} class="year-label mono">
              {year}
            </h2>
            <ol>
              {list.map((e) => {
                const d = e.data;
                const Content = rendered.get(e.id);
                return (
                  <li id={e.id} class={`entry kind-${d.kind}`}>
                    <span class="node" aria-hidden="true" />
                    <time class="mono" datetime={d.date.toISOString()}>
                      {day.format(d.date)}
                      {isDev && d.draft && <em> draft</em>}
                    </time>
                    {d.kind === 'story' ? (
                      <div class="body">
                        <a class="story-title" href={`/story/${e.id}`}>
                          {d.title}
                        </a>
                        <p>{d.description}</p>
                      </div>
                    ) : (
                      <div class="body post">
                        {d.title && <p class="post-title">{d.title}</p>}
                        {Content && <Content />}
                        {d.image && <img src={d.image} alt={d.imageAlt ?? ''} loading="lazy" />}
                        {d.url && (
                          <a class="via mono" href={d.url} rel="noopener">
                            via {SOURCE_LABEL[d.source ?? 'site'] ?? d.source} ↗
                          </a>
                        )}
                      </div>
                    )}
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    )
  }
</Doc>

<style>
  .empty {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--faint);
  }
  .timeline {
    --rail: 0.35rem;
    position: relative;
    margin-top: 2.25rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: var(--rail);
    top: 0.6rem;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }
  .year + .year {
    margin-top: 2.5rem;
  }
  .year-label {
    position: relative;
    margin: 0 0 1rem !important;
    padding-left: 1.75rem;
    font-size: 1.25rem !important;
    font-weight: 400 !important;
    letter-spacing: 0.02em;
    color: var(--text);
    text-transform: none !important;
  }
  .year-label::before {
    left: calc(var(--rail) - 0.3rem) !important;
    top: 0.65em !important;
    width: calc(0.6rem + 1px) !important;
    height: 1px !important;
    background: var(--muted) !important;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0 !important;
  }
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: 0 0.75rem;
    padding: 0 0 1.75rem 1.75rem;
    margin: 0 !important;
    scroll-margin-top: 2rem;
  }
  .entry:target .body {
    outline: 1px solid var(--line);
    outline-offset: 0.6rem;
  }
  .node {
    position: absolute;
    left: calc(var(--rail) - 3px);
    top: 0.45rem;
    width: 7px;
    height: 7px;
    background: var(--bg);
    border: 1px solid var(--muted);
    border-radius: 50%;
  }
  .kind-story .node {
    border-radius: 0;
    background: var(--text);
    border-color: var(--text);
  }
  time {
    font-size: 0.6875rem;
    color: var(--faint);
    padding-top: 0.15rem;
    text-transform: uppercase;
    white-space: nowrap;
  }
  time em {
    display: block;
    font-style: normal;
    color: var(--accent);
    text-transform: lowercase;
  }
  .body > :last-child {
    margin-bottom: 0;
  }
  .body p {
    margin: 0 0 0.6em;
  }
  .story-title {
    display: inline-block;
    margin-bottom: 0.25rem;
    font-size: 1.05rem;
    color: var(--text);
    text-decoration: none;
  }
  .story-title:hover {
    text-decoration: underline;
  }
  .post-title {
    color: var(--text);
  }
  .post :global(p) {
    white-space: pre-line;
  }
  .post img {
    margin: 0.75rem 0;
    max-height: 22rem;
    width: auto;
    border: 1px solid var(--line);
    filter: grayscale(0.25);
  }
  .via {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.6875rem;
    color: var(--muted) !important;
    text-decoration: none;
  }
  .via:hover {
    color: var(--text) !important;
  }
  @media (max-width: 30rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }
    time {
      padding: 0 0 0.25rem;
    }
  }
</style>
