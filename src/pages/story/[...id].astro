---
import { render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import { getEntries } from '../../lib/timeline';

// Only long-form stories get their own page; posts and milestones live on the timeline.
export async function getStaticPaths() {
  const stories = (await getEntries()).filter((e) => e.data.kind === 'story');
  return stories.map((story) => ({ params: { id: story.id }, props: { story } }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const dateFmt = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Doc
  title={story.data.title ?? 'Story'}
  description={story.data.description}
  path={`story/${story.id}`}
  type="article"
  published={story.data.date}
>
  <article>
    <h1>{story.data.title}</h1>
    <time class="mono" datetime={story.data.date.toISOString()}>{dateFmt.format(story.data.date)}</time>
    <Content />
  </article>
  <p class="back mono"><a href={`/story#${story.id}`}>← back to the timeline</a></p>
</Doc>

<style>
  time {
    display: block;
    margin-bottom: 2.25rem;
    font-size: 0.6875rem;
    color: var(--faint);
  }
  .back {
    margin-top: 3rem;
    font-size: 0.75rem;
  }
  .back a {
    color: var(--muted) !important;
    text-decoration: none;
  }
</style>
