---
import { render } from 'astro:content';
import Doc from '../layouts/Doc.astro';
import { getEntries, type Entry } from '../lib/timeline';

// Roles, milestones and stories, newest first, grouped by year into a grid of columns.
// Clicking a role (or a milestone with a description) opens its details in a modal.
const entries = (await getEntries())
  .filter((e) => e.data.kind === 'role' || e.data.kind === 'milestone' || e.data.kind === 'story')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const bodies = new Map<string, Awaited<ReturnType<typeof render>>['Content']>();
for (const e of entries) {
  if (e.data.kind === 'role' && (e.body ?? '').trim()) bodies.set(e.id, (await render(e)).Content);
}

const years = new Map<number, Entry[]>();
for (const e of entries) {
  const y = e.data.date.getFullYear();
  if (!years.has(y)) years.set(y, []);
  years.get(y)!.push(e);
}

const monthYear = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });
const range = (d: Entry['data']) => {
  const from = monthYear.format(d.date);
  if (!d.end) return from;
  return `${from} – ${d.end === 'present' ? 'present' : monthYear.format(d.end)}`;
};
const first = entries.at(-1)?.data.date.getFullYear();
---

<Doc
  title="Timeline"
  description="Twenty years of work, from Fortum to Tradesnap: roles, milestones and what was written along the way."
  path="timeline"
  wide
>
  <div class="head">
    <h1>Timeline</h1>
    <p>
      {first ? `Today back to ${first}. ` : ''}Roles, milestones and what was written along the way. Click a line for the
      details.
    </p>
  </div>

  <ol class="grid">
    {
      [...years.entries()].map(([year, list]) => (
        <li class="year">
          <span class="dot" aria-hidden="true" />
          <h2 class="year-label">{year}</h2>
          <ul class="events">
            {list.map((e) => {
              const d = e.data;
              const now = d.kind === 'role' && d.end === 'present';
              if (d.kind === 'story') {
                return (
                  <li class="event kind-story">
                    <a href={`/story/${e.id}`}>
                      Wrote: {d.title}
                    </a>
                  </li>
                );
              }
              if (d.kind === 'milestone' && !d.description) {
                return (
                  <li class="event kind-milestone">
                    <span>{d.title}</span>
                  </li>
                );
              }
              return (
                <li class={`event kind-${d.kind}${now ? ' is-now' : ''}`}>
                  <button class="open" type="button" data-open={e.id} aria-haspopup="dialog">
                    {d.title}
                    {now && <span class="now mono">now</span>}
                  </button>
                </li>
              );
            })}
          </ul>
        </li>
      ))
    }
  </ol>

  <dialog class="sheet" aria-label="Details">
    {
      entries
        .filter((e) => e.data.kind === 'role' || (e.data.kind === 'milestone' && e.data.description))
        .map((e) => {
          const d = e.data;
          const Body = bodies.get(e.id);
          return (
            <article data-for={e.id} hidden>
              <p class="sheet-role mono">
                {d.kind === 'role' ? range(d) : monthYear.format(d.date)}
                {d.place && ` · ${d.place}`}
              </p>
              <h3 id={`sheet-${e.id}`}>{d.title}</h3>
              {d.kind === 'role' && d.end === 'present' && (
                <ul class="chips mono">
                  <li>current</li>
                </ul>
              )}
              {Body ? <Body /> : d.description && <p>{d.description}</p>}
            </article>
          );
        })
    }
    <form method="dialog">
      <button class="close" type="submit">[ close ]</button>
    </form>
  </dialog>
</Doc>

<script>
  const sheet = document.querySelector<HTMLDialogElement>('dialog.sheet');
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.open;
      if (!sheet || !id) return;
      sheet.querySelectorAll<HTMLElement>('article').forEach((a) => (a.hidden = a.dataset.for !== id));
      sheet.setAttribute('aria-labelledby', `sheet-${id}`);
      sheet.showModal();
    });
  });
  sheet?.addEventListener('click', (e) => {
    if (e.target === sheet) sheet.close();
  });
</script>

<style>
  .head {
    max-width: 40rem;
  }

  .grid {
    list-style: none;
    margin: 3rem 0 0 !important;
    padding: 0 !important;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    row-gap: 3.25rem;
  }
  @media (max-width: 64rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 34rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .year {
    position: relative;
    margin: 0 !important;
    padding: 1.6rem 1.75rem 0 0;
  }
  /* the running line: from this year's dot to the next */
  .year::before {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    right: 0;
    height: 1px;
    background: var(--line);
  }
  .year:last-child::before {
    right: auto;
    width: 2.5rem;
    background: linear-gradient(90deg, var(--line), transparent);
  }
  .dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--muted);
  }
  .year:first-child .dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .year-label {
    margin: 0 0 1rem !important;
    font-family: var(--sans) !important;
    font-size: clamp(1.6rem, 2.4vw, 2.1rem) !important;
    font-weight: 600 !important;
    letter-spacing: -0.02em !important;
    text-transform: none !important;
    color: var(--text);
    line-height: 1;
  }
  .year-label::before {
    display: none; /* drop the doc-layout bullet */
  }

  .events {
    list-style: none;
    margin: 0 !important;
    padding: 0 !important;
  }
  .event {
    position: relative;
    margin: 0 0 0.55rem !important;
    padding-left: 1rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .event::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    background: var(--muted);
  }
  .kind-milestone::before {
    background: var(--accent);
    transform: rotate(45deg);
  }
  .kind-milestone {
    color: var(--accent);
  }
  .kind-story a {
    color: var(--text);
  }
  .is-now .open {
    color: var(--text);
  }

  /* the doc layout styles h3 for articles; give the modal title the home-page size */
  .sheet :global(h3) {
    margin: 0.2rem 0 0.75rem;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text);
  }
  .sheet :global(.chips) {
    padding-left: 0 !important;
  }
  .sheet :global(.chips li) {
    margin: 0 !important;
  }
  .sheet :global(p) {
    margin: 0 0 0.8em;
  }
  .open {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    text-decoration: underline dotted var(--faint);
    text-underline-offset: 0.25em;
  }
  .open:hover {
    color: var(--text);
    text-decoration-color: var(--muted);
  }
  .now {
    margin-left: 0.35rem;
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding: 0 0.3rem;
    vertical-align: 0.1em;
  }
</style>
