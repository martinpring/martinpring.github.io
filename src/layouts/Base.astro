---
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
}

const { title, description = SITE.description, type = 'website', published } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/og.png', Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: Astro.site?.toString(),
  email: `mailto:${SITE.email}`,
  jobTitle: 'Founder & CEO',
  worksFor: { '@type': 'Organization', name: 'Real Logic AB' },
  address: { '@type': 'PostalAddress', addressCountry: 'SE' },
  sameAs: [SITE.links.linkedin, SITE.links.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#181716" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}, story`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    <!-- Crosshair cursor with coordinate readout (fine pointers only) -->
    <div class="xhair" aria-hidden="true">
      <span class="xh-x"></span>
      <span class="xh-y"></span>
      <span class="xh-label mono"></span>
    </div>

    <script>
      // ---------- crosshair ----------
      const root = document.querySelector<HTMLElement>('.xhair');
      const label = root?.querySelector<HTMLElement>('.xh-label');
      const fine = window.matchMedia('(pointer: fine)').matches;
      if (root && label && fine) {
        let raf = 0;
        let x = 0;
        let y = 0;
        const draw = () => {
          raf = 0;
          root.style.setProperty('--x', `${x}px`);
          root.style.setProperty('--y', `${y}px`);
          label.textContent = `X: ${Math.round(x)}   Y: ${Math.round(y)}`;
        };
        window.addEventListener(
          'pointermove',
          (e) => {
            x = e.clientX;
            y = e.clientY;
            root.classList.add('on');
            if (!raf) raf = requestAnimationFrame(draw);
          },
          { passive: true },
        );
        document.documentElement.addEventListener('pointerleave', () => root.classList.remove('on'));
      }

      // ---------- text scramble on hover/focus ----------
      // [data-scramble] text flips to symbols, then the real characters are revealed left to right.
      // A [data-scramble-host] (e.g. a logo tile) scrambles every [data-scramble] inside it.
      const SYMBOLS = '_-=+*^#!?<>{}[]/\\|~';
      const STEP = 42; // ms per tick: glyphs refresh and one more character is revealed
      const LEAD = 2; // ticks of pure symbols before the first character settles
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const timers = new WeakMap<HTMLElement, number>();
      const scramble = (el: HTMLElement) => {
        if (reduce || timers.has(el)) return;
        const text = (el.dataset.text ??= (el.textContent ?? '').trim());
        if (!text) return;
        if (!el.hasAttribute('aria-label') && !el.closest('[aria-label], [aria-hidden="true"]')) {
          el.setAttribute('aria-label', text);
        }
        el.style.minWidth = `${el.getBoundingClientRect().width}px`;
        let tick = 0;
        const render = () => {
          const shown = tick - LEAD;
          let out = '';
          for (let i = 0; i < text.length; i++) {
            const c = text[i];
            if (i < shown || /\s/.test(c)) out += c;
            else out += Math.random() < 0.12 ? '\u00a0' : SYMBOLS[(Math.random() * SYMBOLS.length) | 0];
          }
          el.textContent = out;
          if (shown >= text.length) {
            clearInterval(timers.get(el));
            timers.delete(el);
            el.textContent = text;
            el.style.minWidth = '';
          }
          tick++;
        };
        render();
        timers.set(el, window.setInterval(render, STEP));
      };
      const trigger = (e: Event) => {
        const target = e.target as HTMLElement;
        const related = (e as PointerEvent).relatedTarget as Node | null;
        const host = target.closest<HTMLElement>('[data-scramble-host]');
        if (host) {
          if (e.type === 'pointerover' && related && host.contains(related)) return;
          host.querySelectorAll<HTMLElement>('[data-scramble]').forEach(scramble);
          return;
        }
        const el = target.closest<HTMLElement>('[data-scramble]');
        if (!el) return;
        if (e.type === 'pointerover' && related && el.contains(related)) return;
        scramble(el);
      };
      document.addEventListener('pointerover', trigger);
      document.addEventListener('focusin', trigger);
    </script>

    <style>
      .xhair {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 40;
        opacity: 0;
        transition: opacity 200ms;
      }
      .xhair:global(.on) {
        opacity: 1;
      }
      .xh-x,
      .xh-y {
        position: absolute;
        background: rgba(216, 212, 204, 0.06);
      }
      .xh-x {
        left: 0;
        right: 0;
        height: 1px;
        transform: translateY(var(--y));
      }
      .xh-y {
        top: 0;
        bottom: 0;
        width: 1px;
        transform: translateX(var(--x));
      }
      .xh-label {
        position: absolute;
        transform: translate(calc(var(--x) + 14px), calc(var(--y) + 14px));
        font-size: 0.625rem;
        color: var(--muted);
        white-space: pre;
      }
      @media (pointer: coarse) {
        .xhair {
          display: none;
        }
      }
    </style>
  </body>
</html>
