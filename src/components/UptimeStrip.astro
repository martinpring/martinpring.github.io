---
// One bar per quarter since the start of my career, drawn like a status-page uptime history.
// The current quarter is partly filled to show how far into it we are (as of build time).
import { SITE } from '../site';

const now = new Date();
const startYear = SITE.careerStart.year;
const startQ = Math.floor((SITE.careerStart.month - 1) / 3);
const nowQ = Math.floor(now.getMonth() / 3);
const total = (now.getFullYear() - startYear) * 4 + (nowQ - startQ) + 1;

const qStart = new Date(now.getFullYear(), nowQ * 3, 1).getTime();
const qEnd = new Date(now.getFullYear(), nowQ * 3 + 3, 1).getTime();
const progress = Math.max(0.15, (now.getTime() - qStart) / (qEnd - qStart));

const bars = Array.from({ length: total }, (_, i) => {
  const q = startQ + i;
  return {
    label: `Q${(q % 4) + 1} ${startYear + Math.floor(q / 4)}`,
    fill: i === total - 1 ? progress : 1,
  };
});
const years = now.getFullYear() - startYear;
---

<figure class="uptime">
  <div class="bars" style={`--n:${total}`} role="img" aria-label={`${years} years of shipping production systems, ${startYear} to today`}>
    {bars.map((b, i) => <span style={`--i:${i};--fill:${b.fill}`} title={b.label} />)}
  </div>
  <figcaption>
    <span>{startYear}</span>
    <span class="status"><span class="dot" aria-hidden="true"></span>{years} years shipping to production</span>
    <span>Today</span>
  </figcaption>
</figure>

<style>
  .uptime {
    margin: 0;
  }
  .bars {
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    gap: clamp(2px, 0.35vw, 4px);
    align-items: end;
    height: clamp(2.75rem, 7vw, 4.5rem);
  }
  .bars span {
    display: block;
    height: calc(var(--fill) * 100%);
    background: var(--ok);
    border-radius: 1px;
    transform-origin: bottom;
    animation: rise 520ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 14ms + 150ms);
  }
  .bars span:last-child {
    background: repeating-linear-gradient(
      -45deg,
      var(--ok) 0 3px,
      var(--ok-soft) 3px 6px
    );
  }
  .bars span:hover {
    background: var(--ink);
  }
  @keyframes rise {
    from {
      transform: scaleY(0);
    }
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--steel);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 var(--ok);
    animation: pulse 2.4s ease-out infinite 2.5s;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }
</style>
