---
const year = new Date().getFullYear();
const links = [
  { href: '/', label: '/index' },
  { href: '/story', label: '/story' },
  { href: '/timeline', label: '/timeline' },
  { href: '/privacy', label: '/privacy' },
];
---

<footer class="foot mono">
  <p>© {year} Martin Pring. All rights reserved.</p>
  <ul>
    {
      links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .foot {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    height: 2.6rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0 var(--gutter);
    background: var(--bg);
    border-top: 1px solid var(--line-soft);
    font-size: 0.625rem;
    color: var(--faint);
  }
  p {
    margin: 0;
  }
  ul {
    justify-self: end;
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
  }
  @media (max-width: 40rem) {
    p {
      display: none;
    }
  }
</style>
